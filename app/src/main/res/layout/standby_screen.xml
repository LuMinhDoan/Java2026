<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Phần Logo và Tiêu đề căn giữa -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_illustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dùng tools:src để hiển thị ảnh mẫu (chỉ có tác dụng xem trước) -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            tools:src="@tools:sample/avatars"
            app:tint="#1A73E8"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quản lý nhà trọ"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dễ dàng quản lý - Hiệu quả hơn"
            android:textSize="16sp"
            android:textColor="#546E7A"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Phần background thành phố và text dưới cùng -->
    <FrameLayout
        android:id="@+id/fl_bottom_illustration"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dùng tools:src để hiển thị ảnh phong cảnh mẫu -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giải pháp quản lý phòng trọ\ncho chủ nhà trọ"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>